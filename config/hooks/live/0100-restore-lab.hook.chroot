#!/bin/sh
set -e

mkdir -p /etc/skel/Desktop /etc/skel/.config/autostart /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml /usr/share/restore-lab /usr/local/bin

cat > /etc/skel/Desktop/Start-Setup-Preview.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Start Setup Preview
Comment=Open the Restore Lab Windows-style setup simulator
Exec=/usr/local/bin/restore-setup-demo
Icon=preferences-system
Terminal=false
Categories=System;
EOF
chmod 755 /etc/skel/Desktop/Start-Setup-Preview.desktop

cat > /etc/skel/Desktop/Install-Restore-Lab.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install Restore Lab
Comment=Install the Debian-based Restore Lab system onto a selected drive
Exec=calamares-install-debian
Icon=install-debian
Terminal=false
Categories=System;
EOF
chmod 755 /etc/skel/Desktop/Install-Restore-Lab.desktop

cat > /etc/skel/Desktop/Firefox.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Firefox ESR
Exec=firefox-esr
Icon=firefox-esr
Terminal=false
Categories=Network;WebBrowser;
EOF
chmod 755 /etc/skel/Desktop/Firefox.desktop

cat > /etc/skel/Desktop/Choose-Desktop-Style.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Choose Desktop Style
Comment=Choose a Windows-inspired Linux desktop appearance
Exec=restore-theme
Icon=preferences-desktop-theme
Terminal=false
Categories=Settings;DesktopSettings;
EOF
chmod 755 /etc/skel/Desktop/Choose-Desktop-Style.desktop

cat > /usr/local/bin/restore-setup-demo <<'EOF'
#!/bin/sh
exec firefox-esr --kiosk file:///usr/share/restore-lab/setup-demo/index.html
EOF
chmod 755 /usr/local/bin/restore-setup-demo

cat > /usr/local/bin/restore-welcome <<'EOF'
#!/bin/sh
set -eu

choice="$(zenity --list --radiolist \
  --title='Welcome to Restore Lab' \
  --text='Choose what you want to do. The live demo does not install or change your disks.' \
  --column='Select' --column='Action' \
  TRUE 'Try the live setup demo' \
  FALSE 'Install Restore Lab to a selected drive' \
  FALSE 'Use the live desktop only' \
  --width=560 --height=300 2>/dev/null)" || exit 0

case "$choice" in
  'Try the live setup demo')
    exec /usr/local/bin/restore-setup-demo
    ;;
  'Install Restore Lab to a selected drive')
    if zenity --question \
      --title='Before installing Restore Lab' \
      --text='This installs a Debian-based Linux system. It is NOT Microsoft Windows. The installer will let you choose a drive and partitions. Some choices can erase Windows and personal files. Back up important files first, and ask a trusted adult for help if you are unsure. Continue to the installer?' \
      --ok-label='Open installer' --cancel-label='Go back' 2>/dev/null; then
      exec calamares-install-debian
    fi
    ;;
  'Use the live desktop only')
    exit 0
    ;;
esac
EOF
chmod 755 /usr/local/bin/restore-welcome

cat > /usr/local/bin/restore-theme <<'EOF'
#!/bin/sh
choice="$(zenity --list --title='Restore Lab Desktop Styles' --text='Choose a visual style. These are Linux desktop themes, not Windows.' --column='Style' 'Windows 11 inspired' 'Windows 10 inspired' 'Windows 7 inspired' 'Windows Vista inspired' 'Windows XP inspired' 2>/dev/null)" || exit 0
case "$choice" in
  'Windows 11 inspired') theme='Arc-Dark'; icons='Papirus-Dark' ;;
  'Windows 10 inspired') theme='Greybird'; icons='Papirus' ;;
  'Windows 7 inspired') theme='Adwaita'; icons='Adwaita' ;;
  'Windows Vista inspired') theme='Numix'; icons='Numix' ;;
  'Windows XP inspired') theme='Greybird'; icons='Adwaita' ;;
  *) exit 0 ;;
esac
xfconf-query -c xsettings -p /Net/ThemeName --create -t string -s "$theme"
xfconf-query -c xsettings -p /Net/IconThemeName --create -t string -s "$icons"
xfconf-query -c xfwm4 -p /general/theme --create -t string -s "$theme"
zenity --info --title='Restore Lab' --text="Applied the $choice appearance. This changes the Linux desktop theme only." 2>/dev/null || true
EOF
chmod 755 /usr/local/bin/restore-theme

cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
</channel>
EOF

cat > /etc/skel/.config/autostart/restore-setup-demo.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Restore Lab Welcome
Exec=/usr/local/bin/restore-welcome
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF

cat > /usr/share/restore-lab/ABOUT.txt <<'EOF'
RESTORE LAB — INSTALLABLE LIVE SYSTEM

Restore Lab is based on Debian GNU/Linux and includes the XFCE desktop.
The live USB can run without installing. Choose "Install Restore Lab" to
open the graphical Calamares installer and install the system to a selected
internal or external drive.

IMPORTANT:
- This is NOT Microsoft Windows and contains no Windows installation files.
- The live demo is visual only and does not modify disks.
- Installing to a drive can erase its files, including Windows. Back up first.
- Read every partition and target-drive screen carefully before confirming.
- Do not remove the USB installer while the system is installing.

The Windows-inspired desktop styles change Linux themes only.
EOF

# Remove downloaded package archives and index caches from the final live filesystem.
rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/*
find /var/log -type f -exec truncate -s 0 {} \; || true
